# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real secrets.

# ── Database ───────────────────────────────────────────────────
# Matches the docker-compose.yml service.
DATABASE_URL=postgres://ferrobank:ferrobank@localhost:5432/ferrobank

# ── HTTP server ────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8080

# ── Session ────────────────────────────────────────────────────
# Must be at least 64 bytes. Generate one with:
#   openssl rand -base64 64
SESSION_SECRET=replace-me-with-64-random-bytes-from-openssl-rand-base64-64-please

# ── Logging ────────────────────────────────────────────────────
# Per-target log levels. Comma separated. See tracing-subscriber EnvFilter.
RUST_LOG=ferrobank=debug,actix_web=info,sqlx=warn

# ── SQLx ───────────────────────────────────────────────────────
# Set to true in CI where there is no live DB. Locally, leave unset
# so SQLx checks queries against the running Postgres.
# SQLX_OFFLINE=true
